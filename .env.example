# Slack app credentials (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# LLM providers — Linda starts fine with zero, one, or both configured.
# With neither set, LLM-dependent tasks fail gracefully with a clear
# "no provider available" message rather than crashing at startup.
# Model IDs per provider/tier live in src/config/models.config.ts, not here.
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-openai-key

# Optional hard spend guardrails (USD). Leave unset/blank to disable —
# unset means "no limit", not "$0". See src/core/budgetGuard.ts.
LLM_DAILY_BUDGET_USD=
LLM_MONTHLY_BUDGET_USD=

# Logging
LOG_LEVEL=info

# Storage — task history and LLM usage/cost telemetry share this SQLite
# file in separate tables (tasks, llm_usage).
DATABASE_PATH=./data/linda.db

# Filesystem tool sandbox root (Developer Agent may only read/write inside this dir)
FS_SANDBOX_ROOT=./workspace
